<% locals.activePage = 'admin' %>
<%- include('partials/header') %>

<main class="page-main">
  <div class="admin-header">
    <div>
      <h1><i class="fa-solid fa-gauge"></i> Admin Dashboard</h1>
      <p>Manage all support tickets generated by the Expert System.</p>
    </div>
    <a href="/query" class="btn btn-primary">
      <i class="fa-solid fa-plus"></i> New Query
    </a>
  </div>

  <!-- Stats Cards -->
  <div class="stats-row">
    <div class="stat-card blue">
      <div class="sc-icon"><i class="fa-solid fa-ticket"></i></div>
      <div class="sc-body">
        <span class="sc-num"><%= totalCount %></span>
        <span class="sc-label">Total Tickets</span>
      </div>
    </div>
    <div class="stat-card green">
      <div class="sc-icon"><i class="fa-solid fa-circle-check"></i></div>
      <div class="sc-body">
        <span class="sc-num"><%= tickets.filter(t => t.status === 'Resolved').length %></span>
        <span class="sc-label">Resolved</span>
      </div>
    </div>
    <div class="stat-card orange">
      <div class="sc-icon"><i class="fa-solid fa-circle-dot"></i></div>
      <div class="sc-body">
        <span class="sc-num"><%= tickets.filter(t => t.status === 'Open').length %></span>
        <span class="sc-label">Open</span>
      </div>
    </div>
    <div class="stat-card purple">
      <div class="sc-icon"><i class="fa-solid fa-spinner"></i></div>
      <div class="sc-body">
        <span class="sc-num"><%= tickets.filter(t => t.status === 'In Progress').length %></span>
        <span class="sc-label">In Progress</span>
      </div>
    </div>
  </div>

  <!-- Search Bar -->
  <form action="/admin" method="GET" class="search-form">
    <div class="search-wrap">
      <i class="fa-solid fa-magnifying-glass search-icon"></i>
      <input
        type="text"
        name="search"
        placeholder="Search by name, email, ticket ID, or category..."
        value="<%= search %>"
        class="search-input"
      />
      <button type="submit" class="btn btn-primary search-btn">Search</button>
      <% if (search) { %>
        <a href="/admin" class="btn btn-outline">Clear</a>
      <% } %>
    </div>
  </form>

  <!-- Tickets Table -->
  <div class="table-card">
    <div class="table-card-header">
      <h3>
        <i class="fa-solid fa-list"></i>
        <%= search ? `Search Results for "${search}"` : 'All Support Tickets' %>
        <span class="ticket-count-badge"><%= tickets.length %></span>
      </h3>
    </div>

    <% if (tickets.length === 0) { %>
      <div class="empty-state">
        <i class="fa-solid fa-inbox"></i>
        <p>No tickets found<%= search ? ` for "${search}"` : '' %>.</p>
        <a href="/query" class="btn btn-outline">Submit First Query</a>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Ticket ID</th>
              <th>Name</th>
              <th>Email</th>
              <th>Category</th>
              <th>Problem</th>
              <th>Status</th>
              <th>Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% tickets.forEach(ticket => { %>
              <tr>
                <td><span class="tid-chip"><%= ticket.ticketId %></span></td>
                <td><strong><%= ticket.name %></strong></td>
                <td class="email-cell"><%= ticket.email %></td>
                <td><span class="cat-chip"><%= ticket.category %></span></td>
                <td class="problem-cell" title="<%= ticket.problem %>">
                  <%= ticket.problem.length > 60 ? ticket.problem.substring(0, 60) + '...' : ticket.problem %>
                </td>
                <td>
                  <!-- Status Update Form -->
                  <form action="/admin/update-status/<%= ticket._id %>?_method=POST" method="POST">
                    <select name="status" class="status-select <%= ticket.status.toLowerCase().replace(' ','-') %>"
                      onchange="this.form.submit()">
                      <option <%= ticket.status === 'Open' ? 'selected' : '' %>>Open</option>
                      <option <%= ticket.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                      <option <%= ticket.status === 'Resolved' ? 'selected' : '' %>>Resolved</option>
                    </select>
                  </form>
                </td>
                <td class="date-cell">
                  <%= new Date(ticket.createdAt).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %>
                </td>
                <td>
                  <!-- Delete Ticket -->
                  <form action="/admin/<%= ticket._id %>?_method=DELETE" method="POST"
                    onsubmit="return confirm('Delete ticket <%= ticket.ticketId %>? This cannot be undone.')">
                    <button type="submit" class="btn-delete" title="Delete Ticket">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
