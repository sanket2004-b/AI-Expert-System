<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> | AI Help Desk</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
</head>
<body>

<!-- ── Navigation Bar ── -->
<nav class="navbar">
  <div class="nav-brand">
    <span class="brand-icon"><i class="fa-solid fa-brain"></i></span>
    <span class="brand-text">AI HelpDesk<span class="brand-dot">.</span></span>
  </div>
  <ul class="nav-links">
    <li><a href="/" class="nav-link <%= locals.activePage === 'home' ? 'active' : '' %>">
      <i class="fa-solid fa-house"></i> Home
    </a></li>
    <li><a href="/query" class="nav-link <%= locals.activePage === 'query' ? 'active' : '' %>">
      <i class="fa-solid fa-circle-question"></i> Ask Query
    </a></li>
    <li><a href="/admin" class="nav-link <%= locals.activePage === 'admin' ? 'active' : '' %>">
      <i class="fa-solid fa-gauge"></i> Admin
    </a></li>
    <li><a href="/about" class="nav-link <%= locals.activePage === 'about' ? 'active' : '' %>">
      <i class="fa-solid fa-circle-info"></i> About
    </a></li>
  </ul>
  <button class="nav-toggle" id="navToggle">
    <i class="fa-solid fa-bars"></i>
  </button>
</nav>

<!-- ── Flash Messages ── -->
<% if (locals.success && locals.success.length > 0) { %>
  <div class="flash flash-success">
    <i class="fa-solid fa-circle-check"></i> <%= locals.success[0] %>
    <button class="flash-close" onclick="this.parentElement.remove()">×</button>
  </div>
<% } %>
<% if (locals.error && locals.error.length > 0) { %>
  <div class="flash flash-error">
    <i class="fa-solid fa-triangle-exclamation"></i> <%= locals.error[0] %>
    <button class="flash-close" onclick="this.parentElement.remove()">×</button>
  </div>
<% } %>
